---
/**
 * Full-text search, as a command palette — the shape Starlight uses, and with it
 * the Nx docs: a trigger styled as a search bar, a native `<dialog>` over a dimmed
 * page, results grouped by page with their matching headings underneath.
 *
 * The index is Pagefind's, built over `dist/` after the Astro build (see the
 * `build` script) from whatever is marked `data-pagefind-body` — the `<main>` of
 * each page, so the sidebar and header don't match everything.
 *
 * Results are rendered here rather than by `@pagefind/default-ui`: that bundle
 * polls `while (!pagefind) { init(); await sleep(50) }` waiting for an init that
 * never resolved in this setup, leaving "Searching for…" on screen forever, while
 * the runtime API underneath answers correctly. Fewer moving parts, and this way
 * the palette is styled from the site's own tokens instead of fighting theirs.
 */
---

<site-search>
  <button class="search-trigger" data-open-modal disabled aria-label="Search the docs" aria-keyshortcuts="Control+K">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="M20 20l-3.5-3.5" />
    </svg>
    <span class="search-trigger-label">Search</span>
    <kbd class="search-trigger-kbd" style="display: none;"><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
  </button>

  <dialog class="search-dialog" aria-label="Search the docs">
    <div class="search-frame">
      <div class="search-head">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-3.5-3.5" />
        </svg>
        <input
          type="search"
          data-search-input
          placeholder="Search the docs…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search query"
          aria-controls="search-results"
        />
        <button class="search-cancel" data-close-modal aria-label="Close search">Esc</button>
      </div>
      <p class="search-status" data-search-status role="status" aria-live="polite"></p>
      <ul class="search-results" id="search-results" data-search-results></ul>
    </div>
  </dialog>
</site-search>

{/* Inline so the shortcut never flashes the wrong key. navigator.platform is
    deprecated but remains the reliable Apple check — the UA string is spoofed by
    some browsers once devtools is open. */}
<script is:inline>
  (() => {
    const hint = document.querySelector('.search-trigger-kbd');
    if (!(hint instanceof HTMLElement)) return;
    const key = hint.querySelector('kbd');
    if (key && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      key.textContent = '⌘';
      hint.closest('button')?.setAttribute('aria-keyshortcuts', 'Meta+K');
    }
    hint.style.display = '';
  })();
</script>

<script>
  interface SubResult {
    title: string;
    url: string;
    excerpt: string;
  }
  interface Result {
    url: string;
    excerpt: string;
    meta: { title?: string };
    sub_results: SubResult[];
  }

  class SiteSearch extends HTMLElement {
    constructor() {
      super();
      const openBtn = this.querySelector<HTMLButtonElement>('[data-open-modal]')!;
      const closeBtn = this.querySelector<HTMLButtonElement>('[data-close-modal]')!;
      const dialog = this.querySelector('dialog')!;
      const frame = this.querySelector('.search-frame')!;
      const input = this.querySelector<HTMLInputElement>('[data-search-input]')!;
      const list = this.querySelector<HTMLElement>('[data-search-results]')!;
      const status = this.querySelector<HTMLElement>('[data-search-status]')!;

      const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
      let pagefind: any = null;
      let loading: Promise<any> | null = null;
      let seq = 0; // drops the answer to a query the reader has already typed past

      /** Load the runtime once. Absent in `astro dev`, where no index is built. */
      const load = () => {
        if (pagefind) return Promise.resolve(pagefind);
        if (!loading) {
          loading = import(/* @vite-ignore */ `${base}pagefind/pagefind.js`)
            .then(async (mod) => {
              // Pagefind records URLs relative to the directory it indexed (dist/),
              // so they need the base path back or every result 404s. The trailing
              // slash matters: without it the join produces "/ci-doctorconcepts/".
              await mod.options({ baseUrl: base, excerptLength: 20 });
              pagefind = mod;
              return mod;
            })
            .catch(() => null);
        }
        return loading;
      };

      const escape = (s: string) =>
        s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

      const render = (items: Result[], query: string) => {
        if (!items.length) {
          list.innerHTML = '';
          status.textContent = query ? `No results for “${query}”.` : '';
          return;
        }
        status.textContent = `${items.length} page${items.length === 1 ? '' : 's'}`;
        // `excerpt` is Pagefind's own HTML — the query terms wrapped in <mark> —
        // built from this site's indexed text, so it is ours, not reader input.
        list.innerHTML = items
          .map((r) => {
            // Pagefind's first sub-result is the page itself (no anchor); the rest
            // are the headings it matched under.
            const sections = (r.sub_results || []).filter((s) => s.url !== r.url);
            // The headline links at the best-matching section rather than the top of
            // the page: landing on a heading you can see the term in beats landing on
            // a page you then have to search by eye.
            const target = sections[0]?.url || r.url;
            const rest = sections
              .slice(1, 5)
              .map(
                (s) => `<li>
                  <a class="section" href="${escape(s.url)}">
                    <span class="section-title">${escape(s.title)}</span>
                    <span class="excerpt">${s.excerpt}</span>
                  </a>
                </li>`,
              )
              .join('');
            return `<li class="hit">
              <a class="page" href="${escape(target)}">
                <span class="page-title">${escape(r.meta?.title || r.url)}</span>
                ${sections[0] ? `<span class="page-section">${escape(sections[0].title)}</span>` : ''}
                <span class="excerpt">${sections[0]?.excerpt || r.excerpt}</span>
              </a>
              ${rest ? `<ul class="sections">${rest}</ul>` : ''}
            </li>`;
          })
          .join('');
      };

      const run = async (query: string) => {
        const mine = ++seq;
        if (!query.trim()) return render([], '');
        const mod = await load();
        if (!mod) {
          // Only reachable under `astro dev`, which builds no index. Name the
          // command that does rather than describing the limitation.
          status.textContent = 'No index in dev — run `mise run docs:preview` to search locally.';
          return;
        }
        status.textContent = 'Searching…';
        const res = await mod.search(query);
        const items: Result[] = await Promise.all(res.results.slice(0, 6).map((r: any) => r.data()));
        if (mine === seq) render(items, query); // a later keystroke already won
      };

      let timer: ReturnType<typeof setTimeout>;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        const query = input.value;
        load(); // warm the index while they are still typing
        timer = setTimeout(() => run(query), 150);
      });

      /** A click on a result, or anywhere outside the frame, closes the palette. */
      const onClick = (event: MouseEvent) => {
        const isLink = 'href' in (event.target || {});
        if (isLink || (document.body.contains(event.target as Node) && !frame.contains(event.target as Node))) {
          dialog.close();
        }
      };

      const open = (event?: MouseEvent) => {
        dialog.showModal();
        document.body.toggleAttribute('data-search-open', true);
        input.focus();
        input.select();
        load();
        event?.stopPropagation(); // the click that opened it must not close it again
        window.addEventListener('click', onClick);
      };

      openBtn.addEventListener('click', open);
      openBtn.disabled = false; // enabled only once there is a handler behind it
      closeBtn.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => {
        document.body.toggleAttribute('data-search-open', false);
        window.removeEventListener('click', onClick);
      });

      window.addEventListener('keydown', (e) => {
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement)?.tagName || '');
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          dialog.open ? dialog.close() : open();
          e.preventDefault();
        } else if (e.key === '/' && !typing && !dialog.open) {
          open();
          e.preventDefault();
        }
      });

      // Arrow keys walk the results by moving real focus, so Enter follows the link
      // natively and a screen reader announces each one as it lands.
      dialog.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        const links = [...list.querySelectorAll('a')];
        if (!links.length) return;
        e.preventDefault();
        const at = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (e.key === 'ArrowDown') links[at < 0 ? 0 : Math.min(at + 1, links.length - 1)].focus();
        else if (at <= 0) input.focus();
        else links[at - 1].focus();
      });
    }
  }
  customElements.define('site-search', SiteSearch);
</script>

<style is:global>
  site-search {
    display: contents;
  }
  [data-search-open] {
    overflow: hidden; /* the page must not scroll behind the modal */
  }

  /* --- the trigger ------------------------------------------------------- */

  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 34px;
    height: 34px;
    padding: 0;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    color: var(--muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .search-trigger:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }
  .search-trigger svg { width: 15px; height: 15px; flex-shrink: 0; }
  .search-trigger-label,
  .search-trigger-kbd { display: none; }

  /* Wide enough, and it becomes a bar — the way a search field reads. */
  @media (min-width: 800px) {
    .search-trigger {
      width: 100%;
      max-width: 15rem;
      justify-content: flex-start;
      padding-inline: 0.7rem 0.45rem;
    }
    .search-trigger-label { display: block; }
    .search-trigger-kbd {
      display: flex;
      gap: 0.15rem;
      margin-inline-start: auto; /* pinned right, like every palette hint */
    }
  }
  .search-trigger-kbd kbd {
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.5;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--muted);
  }

  /* --- the dialog -------------------------------------------------------- */

  .search-dialog {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    border: 0;
    background: var(--card);
    color: var(--fg);
  }
  /* Gated on [open]: an unconditional `display` beats the UA's
     `dialog:not([open]) { display: none }`, and the palette then sits in the page
     permanently — unclosable, and with no backdrop, since ::backdrop only paints
     for a dialog opened with showModal(). */
  .search-dialog[open] {
    display: flex;
  }
  .search-dialog::backdrop {
    background: rgb(9 12 17 / 0.6);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  .search-frame {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
  }

  .search-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .search-head svg { width: 17px; height: 17px; color: var(--muted); flex-shrink: 0; }
  .search-head input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
  }
  .search-head input::-webkit-search-cancel-button { display: none; }
  .search-cancel {
    flex-shrink: 0;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-subtle);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    cursor: pointer;
  }
  .search-cancel:hover { color: var(--fg); border-color: var(--border-strong); }

  .search-status {
    margin: 0;
    padding: 0.5rem 1rem 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .search-status:empty { display: none; }

  /* --- results ----------------------------------------------------------- */

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .search-results .hit + .hit {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--border);
  }
  .search-results a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
  }
  .search-results a:hover,
  .search-results a:focus-visible {
    background: var(--bg-subtle);
    outline: none;
  }
  .page-title {
    font-weight: 650;
    font-size: 0.94rem;
  }
  /* The heading the headline link actually lands on, so the jump is never a surprise. */
  .page-section::before {
    content: '›';
    margin: 0 0.35rem;
    color: var(--border-strong);
  }
  .page-section {
    font-size: 0.9rem;
    color: var(--accent);
  }
  .excerpt {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .excerpt mark {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--fg);
    border-radius: 3px;
    padding: 0 0.1em;
  }
  /* The page's other matching headings, as a tree under it. */
  .sections {
    list-style: none;
    margin: 0.1rem 0 0 1.1rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--border);
  }
  .section-title {
    display: block;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--accent);
  }
  .sections .excerpt { font-size: 0.79rem; }

  @media (min-width: 800px) {
    .search-dialog {
      margin: 4.5rem auto auto;
      width: 90%;
      max-width: 38rem;
      height: max-content;
      max-height: calc(100% - 9rem);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
    }
  }
</style>
