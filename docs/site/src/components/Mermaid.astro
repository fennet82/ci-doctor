---
/**
 * A mermaid diagram, rendered in the browser from the site's own CSS tokens so
 * it can never drift from the palette around it — and re-rendered when the
 * reader flips the theme.
 */
interface Props {
  /** Mermaid source. */
  code: string;
  /** Alt text: the rendered SVG is one image as far as a screen reader is concerned. */
  label: string;
  caption?: string;
}
const { code, label, caption } = Astro.props;
---

<figure class="diagram">
  <div class="mermaid" role="img" aria-label={label} data-diagram={code}></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import mermaid from 'mermaid';

  const nodes = document.querySelectorAll<HTMLElement>('.mermaid[data-diagram]');
  if (nodes.length) {
    const token = (name: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    let seq = 0;
    const draw = () => {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        fontFamily: token('--sans'),
        // useMaxWidth caps the SVG at its natural width and lets it shrink below
        // that: a diagram narrower than the column renders at full size, a wider
        // one scales to fit instead of hanging outside the column with its right
        // edge cut off. Height is bounded by the CSS below, not here.
        flowchart: { curve: 'basis', padding: 14, useMaxWidth: true, nodeSpacing: 45, rankSpacing: 55 },
        themeVariables: {
          background: token('--bg'),
          primaryColor: token('--accent-soft'),
          primaryTextColor: token('--fg'),
          primaryBorderColor: token('--border-strong'),
          secondaryColor: token('--bg-subtle'),
          tertiaryColor: token('--card'),
          lineColor: token('--border-strong'),
          textColor: token('--fg'),
          clusterBkg: token('--bg-subtle'),
          clusterBorder: token('--border'),
          edgeLabelBackground: token('--bg'),
          fontSize: '16px',
        },
      });
      nodes.forEach(async (el) => {
        const { svg } = await mermaid.render(`d${seq++}`, el.dataset.diagram!);
        el.innerHTML = svg;
      });
    };

    draw();
    // The header toggle stamps data-theme on <html>; with nothing stamped the OS
    // can still flip underneath us. Both are a redraw.
    new MutationObserver(draw).observe(document.documentElement, {
      attributeFilter: ['data-theme'],
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', draw);
  }
</script>

<style is:global>
  /* Global: the SVG is injected after scoping, so a scoped rule would miss it. */
  .diagram {
    margin: 1.75rem 0;
  }

  .diagram .mermaid {
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    padding: 1.1rem 0.75rem;
    box-shadow: var(--shadow-sm);
    /* Reserve height so the page does not jump when the diagram lands. */
    min-height: 8rem;
    /* A tall flowchart is 1700px of natural height — two screens of one box on a
       desktop. Bound the frame and scroll inside it; the type stays full size. */
    max-height: 80vh;
  }

  .diagram .mermaid svg {
    display: block;
    margin: 0 auto;
    height: auto;
  }

  .diagram figcaption {
    margin-top: 0.6rem;
    font-size: 0.86rem;
    color: var(--muted);
    text-align: center;
  }
</style>
