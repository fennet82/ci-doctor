---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { asset, url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Postmortem CI failure analyzer — deterministic phase attribution plus an optional LLM explanation.',
} = Astro.props;

const REPO = 'https://github.com/fennet82/ci-doctor';

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={asset('/ci-doctor-icon.svg')} />
    <title>{title} · ci-doctor</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · ci-doctor`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={asset('/ci-doctor-logo.png')} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Before first paint: otherwise a dark-theme visitor gets a white flash,
        and a reader who collapsed the sidebar sees it flash back in. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
        if (localStorage.getItem('sidebar') === 'collapsed') {
          document.documentElement.dataset.sidebar = 'collapsed';
        }
      } catch {}
    </script>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <nav class="nav">
        <a class="brand" href={url('/')}>
          <img src={asset('/ci-doctor-icon.svg')} alt="" width="26" height="26" />
          <span>ci-doctor</span>
        </a>

        <span class="nav-spacer"></span>

        <a class="icon-btn" href={REPO} aria-label="Source on GitHub">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>

        <button class="icon-btn nav-toggle" id="nav-toggle" aria-label="Toggle sidebar" aria-expanded="true" aria-controls="sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2.5" />
            <path d="M9.5 4v16" />
          </svg>
        </button>

        <button class="icon-btn" id="theme-toggle" aria-label="Toggle colour theme">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </nav>
    </header>

    <div class="shell">
      <Sidebar here={Astro.url.pathname} />
      <main id="content">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="inner">
        <span>Read-only CI postmortem. It never edits code and always exits&nbsp;0.</span>
        <span><a href={REPO}>GitHub</a> · <a href={`${REPO}/blob/master/LICENSE`}>MIT</a></span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        // No stored preference yet: flip away from whatever the OS is giving us.
        const current =
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // One button, two modes: on a wide screen the sidebar is a column that
      // collapses (and the choice sticks); below 1000px it is a drawer.
      const sidebar = document.getElementById('sidebar');
      const navToggle = document.getElementById('nav-toggle');
      const wide = matchMedia('(min-width: 1001px)');
      const root = document.documentElement;

      const syncLabel = () => {
        const shown = wide.matches
          ? root.dataset.sidebar !== 'collapsed'
          : !!sidebar?.classList.contains('open');
        navToggle?.setAttribute('aria-expanded', String(shown));
      };
      syncLabel();
      wide.addEventListener('change', syncLabel);

      navToggle?.addEventListener('click', () => {
        if (wide.matches) {
          const collapsed = root.dataset.sidebar === 'collapsed';
          if (collapsed) delete root.dataset.sidebar;
          else root.dataset.sidebar = 'collapsed';
          try { localStorage.setItem('sidebar', collapsed ? 'expanded' : 'collapsed'); } catch {}
        } else {
          sidebar?.classList.toggle('open');
        }
        syncLabel();
      });

      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
          sidebar.classList.remove('open');
          syncLabel();
        }
      });
    </script>
  </body>
</html>
