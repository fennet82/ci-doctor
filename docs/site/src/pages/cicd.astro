---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';

const gitlab = `# .gitlab-ci.yml — runs only on failure; always exits 0.
ci-doctor:
  stage: .post
  image: registry.internal.example.com/ci-doctor:latest
  rules:
    - when: on_failure
  allow_failure: true
  variables:
    CI_DOCTOR_GITLAB_TOKEN: "$CI_DOCTOR_TOKEN"      # a read-scoped API token
  script:
    - ci-doctor analyze "$CI_PIPELINE_ID"
  artifacts:
    when: always
    expire_in: 1 week
    paths:
      - report.md
      - report.json`;

const gitlabLlm = `  variables:
    CI_DOCTOR_GITLAB_TOKEN: "$CI_DOCTOR_TOKEN"
    CI_DOCTOR_LLM__MODEL: "qwen2.5-coder:32b"
    CI_DOCTOR_LLM__API_BASE: "http://vllm.internal:8000/v1"
    # CI_DOCTOR_LLM__API_KEY... uses api_key_env if your gateway needs one`;

const gitlabMr = `  variables:
    CI_DOCTOR_GITLAB_TOKEN: "$CI_DOCTOR_TOKEN"
    CI_DOCTOR_OUTPUT__MR_NOTE: "true"   # post/update one note when confidence >= medium`;

const github = `# .github/workflows/ci-doctor.yml
name: ci-doctor
on:
  workflow_run:
    workflows: ["CI"]          # the workflow whose failures you want explained
    types: [completed]

jobs:
  explain:
    if: \${{ github.event.workflow_run.conclusion == 'failure' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write     # only needed for PR notes
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uv sync
      - name: Analyze the failed run
        env:
          CI_DOCTOR_PROVIDER: github
          CI_DOCTOR_GITHUB__BASE_URL: https://api.github.com
          CI_DOCTOR_GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          GITHUB_REPOSITORY: \${{ github.repository }}
        run: uv run ci-doctor analyze "\${{ github.event.workflow_run.id }}"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: ci-doctor-report
          path: |
            report.md
            report.json`;

const docker = `# Build once where there is internet, push to your internal registry:
docker build -t ci-doctor:1.0.0 .
docker tag  ci-doctor:1.0.0 registry.internal.example.com/ci-doctor:1.0.0
docker push registry.internal.example.com/ci-doctor:1.0.0

# The image needs no network at job runtime beyond your GitLab/LLM endpoints.`;

const offline = `# Where there IS internet — build a wheel bundle:
pip wheel . -w ./wheels

# Copy ./wheels inside the air-gapped network, then:
pip install --no-index --find-links ./wheels ci-doctor`;
---
<Base title="CI/CD Examples">
  <h1>CI/CD Examples</h1>
  <p class="lead">Wire it into the <em>post</em> stage so it explains failures without ever changing the outcome.</p>

  <h2>GitLab CI</h2>
  <p>The minimal drop-in — deterministic report, artifacts on every failure:</p>
  <Code code={gitlab} lang="yaml" theme="github-dark" />

  <h3>Add an LLM explanation</h3>
  <p>Point at any OpenAI-compatible endpoint (swap in place of the deterministic-only variables):</p>
  <Code code={gitlabLlm} lang="yaml" theme="github-dark" />

  <h3>Post a note on the merge request</h3>
  <p>Idempotent — it updates its own previous comment instead of spamming. Gated on confidence ≥ medium.</p>
  <Code code={gitlabMr} lang="yaml" theme="github-dark" />

  <h2>GitHub Actions</h2>
  <p>Trigger on the completion of your CI workflow and analyze the failed run:</p>
  <Code code={github} lang="yaml" theme="github-dark" />

  <h2 id="offline">Docker &amp; air-gapped delivery</h2>
  <p>Ship a self-contained image to an internal registry:</p>
  <Code code={docker} lang="bash" theme="github-dark" />
  <p>...or an offline wheel bundle where Docker isn't an option:</p>
  <Code code={offline} lang="bash" theme="github-dark" />

  <div class="note">
    <strong>It always exits 0</strong> and is read-only, so adding this job can never fail your pipeline
    or mask the real error. <code>allow_failure: true</code> on GitLab is belt-and-braces.
  </div>
</Base>
