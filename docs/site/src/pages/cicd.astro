---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const gitlab = `# runs only on failure; always exits 0.
ci-doctor:
  stage: .post
  image: registry.internal.example.com/ci-doctor:latest
  rules:
    - when: on_failure
  allow_failure: true
  variables:
    CI_DOCTOR_GITLAB_TOKEN: "$CI_DOCTOR_TOKEN"      # a read-scoped API token
  script:
    - ci-doctor analyze "$CI_PIPELINE_ID"
  artifacts:
    when: always
    expire_in: 1 week
    paths:
      - report.md
      - report.json`;

const gitlabLlm = `  variables:
    CI_DOCTOR_GITLAB_TOKEN: "$CI_DOCTOR_TOKEN"
    CI_DOCTOR_LLM__MODEL: "qwen2.5-coder:32b"
    CI_DOCTOR_LLM__API_BASE: "http://vllm.internal:8000/v1"
    # CI_DOCTOR_LLM__API_KEY... uses api_key_env if your gateway needs one`;

const gitlabMr = `  variables:
    CI_DOCTOR_GITLAB_TOKEN: "$CI_DOCTOR_TOKEN"
    CI_DOCTOR_OUTPUT__MR_NOTE: "true"   # post/update one note when confidence >= medium`;

const gitlabSelfHosted = `  variables:
    CI_DOCTOR_GITLAB_TOKEN: "$CI_DOCTOR_TOKEN"
    CI_DOCTOR_GITLAB__BASE_URL: "https://gitlab.internal.example.com"
    CI_DOCTOR_GITLAB__CA_BUNDLE: "/etc/ssl/certs/internal-ca.pem"`;

const github = `- uses: fennet82/ci-doctor@master`;

const local = `# Replay a log you saved from a failed job — no network, no token, no LLM:
ci-doctor analyze ~/Downloads/failing-job.log

# Or hit a live run from your checkout. With no CI_PROJECT_ID / GITHUB_REPOSITORY
# set, the repo is read from your git origin (and it says so in a warning):
ci-doctor analyze 123456`;

const docker = `# Build once where there is internet, push to your internal registry:
docker build -t ci-doctor:latest .
docker tag  ci-doctor:latest registry.internal.example.com/ci-doctor:latest
docker push registry.internal.example.com/ci-doctor:latest

# The image needs no network at job runtime beyond your GitLab/LLM endpoints.`;

const offline = `# Where there IS internet — build a wheel bundle:
pip wheel . -w ./wheels

# Copy ./wheels inside the air-gapped network, then:
pip install --no-index --find-links ./wheels ci-doctorr`;
---

<Base title="Examples">
  <h1>Examples</h1>
  <p class="lead">
    Wire it into the <em>post</em> stage so it explains failures without ever changing the outcome.
  </p>

  <h2>GitHub Actions</h2>
  <p>One step. It defaults to the run that triggered it, so there is nothing else to pass:</p>
  <Code code={github} lang="yaml" theme="github-dark" />
  <p>
    Inputs, outputs, PR comments and GitHub Enterprise are all on the
    <a href={url('/action/')}>Action reference →</a>
  </p>

  <h2>GitLab CI</h2>
  <p>The minimal drop-in — deterministic report, artifacts on every failure:</p>
  <figure class="snippet">
    <figcaption>.gitlab-ci.yml</figcaption>
    <Code code={gitlab} lang="yaml" theme="github-dark" />
  </figure>

  <h3>Add an LLM explanation</h3>
  <p>Point at any OpenAI-compatible endpoint (swap in place of the deterministic-only variables):</p>
  <Code code={gitlabLlm} lang="yaml" theme="github-dark" />

  <h3>Post a note on the merge request</h3>
  <p>Idempotent — it updates its own previous comment instead of spamming. Gated on confidence ≥ medium.</p>
  <Code code={gitlabMr} lang="yaml" theme="github-dark" />

  <h3>Self-hosted GitLab</h3>
  <p>Override the API host and hand it your internal CA. Proxy variables are honoured as-is:</p>
  <Code code={gitlabSelfHosted} lang="yaml" theme="github-dark" />

  <h2>On your laptop</h2>
  <p>
    Nothing about ci-doctor requires CI. This is the fastest way to test a
    <code>.ci-doctor.yml</code> or reproduce an attribution you disagree with:
  </p>
  <Code code={local} lang="bash" theme="github-dark" />

  <h2 id="offline">Docker &amp; air-gapped delivery</h2>
  <p>Ship a self-contained image to an internal registry:</p>
  <Code code={docker} lang="bash" theme="github-dark" />
  <p>…or an offline wheel bundle where Docker isn't an option:</p>
  <Code code={offline} lang="bash" theme="github-dark" />

  <div class="note">
    <strong>It always exits 0</strong> and is read-only, so adding this job can never fail your
    pipeline or mask the real error. <code>allow_failure: true</code> on GitLab is belt-and-braces.
  </div>
</Base>
